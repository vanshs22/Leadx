# ---- Core ----
ENVIRONMENT=development            # production | staging | development
# Supabase project URL; this is not the public API origin or portal URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
LEAD_ENGINE_SERVICE_KEY=           # 32+ random chars; required in production
LEAD_ENGINE_DEV_AUTH_BYPASS=0      # legacy dev-only bypass; force-disabled in hardened modes
# Offline synthetic validation is opt-in and requires BOTH flags to be 1.
LOCAL_VALIDATION_MODE=0
LOCAL_AUTHENTICATION_FLAG=0
LOCAL_AUTH_EMAIL=local@example.test
LOCAL_AUTH_PASSWORD=                 # local-only fixture credential; never use a real password
LOCAL_AUTH_PASSWORD_HASH=            # optional pbkdf2_sha256$iterations$salt$digest form
LOCAL_AUTH_SECRET=                   # 32+ random chars; local synthetic JWT signing only
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_TENANT_ID=local-tenant

# ---- Security (new) ----
# Production Acelune example: CORS_ORIGINS=https://acelune.com,https://www.acelune.com
CORS_ORIGINS=                      # comma list of explicit https origins; never use * in production
TRUST_PROXY_HEADERS=0              # 1 ONLY behind a proxy you control (nginx/Caddy/Cloudflare)
TRUSTED_PROXY_HOPS=1
WEBHOOK_SECRET=                    # REQUIRED in production for SES/SNS webhooks (?secret=...)
WEBHOOK_SIGNING_SECRET=            # HMAC-signs outbound webhooks
ALLOW_PRIVATE_OUTBOUND=0           # dev only: lets enrichment/webhooks hit localhost. Ignored in production.
RATE_LIMIT_API_PER_MINUTE=180
REDIS_URL=                         # recommended in production for shared rate limits

# ---- Discovery / enrichment ----
SERPER_API_KEY=
DECODO_API_KEY=                 # Optional Decodo Web Data API key; used before Serper web search
DECODO_API_BASE_URL=https://data.decodo.com/v1
ENRICH_SECONDARY_PAGES=12
ENRICH_SEARCH_FALLBACK=1

# Portal/app URL (separate from PUBLIC_API_URL and SUPABASE_URL).
# Production Acelune example: APP_PUBLIC_URL=https://acelune.com
APP_PUBLIC_URL=http://localhost:3000

# Public API origin used for API links and unsubscribe URLs; keep it separate from SUPABASE_URL.
# Production Acelune example: PUBLIC_API_URL=https://api.acelune.com
# Required in production/staging; localhost values are rejected there.
PUBLIC_API_URL=http://localhost:8000
# Internal secret; generate locally and keep it out of chat, commits, endpoints, and logs.
# Example: python -c "import secrets;print(secrets.token_urlsafe(48))"
UNSUBSCRIBE_SECRET=

# Stripe is optional until payments are enabled. Leave these empty to disable only billing/checkout.
# Never use fake Stripe keys or price IDs as placeholders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# ---- Performance / multi-user (new) ----
WEB_CONCURRENCY=4                  # uvicorn worker processes (set ~= CPU cores)
THREADPOOL_SIZE=120                # threads per worker for sync route handlers
SLOW_REQUEST_MS=1500               # log requests slower than this

# Core Engine 4.0 — intensive free-first discovery
CORE_ENGINE_INTENSIVE_SOURCE_BUDGET=750
LEADX_GOOGLE_MAX_PAGES=0
LEADX_GOOGLE_HARD_PAGE_CAP=1000
LEADX_SOURCE_VALIDATION_CONCURRENCY=24
LEADX_FREE_DISCOVERY_CONCURRENCY=8
LEADX_GOOGLE_PAGE_DELAY=0.8
LEADX_SERPER_FALLBACK_QUERIES=80
LEADX_SERPER_FALLBACK_PAGES=10

# LeadX Core Engine 5.0 — Enrichment Intelligence Mesh
# Paid enrichment providers are opt-in. Native adapters: Apollo/Hunter.
# Generic connector providers require BOTH their *_API_KEY and
# LEADX_PROVIDER_<NAME>_URL. Never paste secrets into source control.
APOLLO_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
SNOV_API_KEY=
LUSHA_API_KEY=
CORESIGNAL_API_KEY=
FINDYMAIL_API_KEY=
ICYPEAS_API_KEY=
PDL_API_KEY=
ZOOMINFO_API_KEY=
COGNISM_API_KEY=
SEAMLESSAI_API_KEY=
FULLENRICH_API_KEY=
BUILTWITH_API_KEY=
WAPPALYZER_API_KEY=
DATANYZE_API_KEY=
HG_INSIGHTS_API_KEY=
SIXSENSE_API_KEY=
DEMANDBASE_API_KEY=
BOMBORA_API_KEY=
CRUNCHBASE_API_KEY=
DEALROOM_API_KEY=
TRACXN_API_KEY=
PITCHBOOK_API_KEY=
OPENCORPORATES_API_KEY=
DNB_API_KEY=
SERPER_API_KEY=
LEADX_MAX_ENRICH_PROVIDERS=25
# Examples (only if you have a supported proxy/connector endpoint):
# LEADX_PROVIDER_PROSPEO_URL=
# LEADX_PROVIDER_LUSHA_URL=
# LEADX_PROVIDER_CORESIGNAL_URL=

# LeadX 6.0 contact verification mesh
ZEROBOUNCE_API_KEY=
ABSTRACT_API_KEY=
NEVERBOUNCE_API_KEY=
BOUNCER_API_KEY=
KICKBOX_API_KEY=
VERIPHONE_API_KEY=
IPQS_API_KEY=
NUMVERIFY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# LeadX 6.1 verification mesh: free/local sources run before free-tier commercial providers, then paid-only.
LEADX_ENABLE_PUBLIC_FREE_VERIFY_APIS=true
LEADX_EMAIL_VALIDATOR_URL=
PHONEVALIDATIONAPI_KEY=
NUMBERS_ONLINE_API_KEY=
NUMBERS_ONLINE_LOOKUP_URL=

# LeadX 11.0 connector platform OAuth apps (server-side only)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=
INTEGRATION_OAUTH_STATE_SECRET=
# Existing Google OAuth app can be reused for Gmail/Calendar/Drive/Sheets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Existing Microsoft app can be reused for Outlook/Calendar/Teams
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_OAUTH_REDIRECT_URI=

# ---- LeadX 16: free/local first, paid only as fallback ---------------------------------
# Order everywhere (discovery, enrichment, verification): local/open data -> free-tier keys -> paid keys.
# A paid provider is called ONLY if its key is set below AND the earlier tiers left a gap.
#   auto   (default) paid lanes run only when free lanes did not satisfy the request
#   always paid lanes always run after free lanes (old behaviour)
#   never  never call paid lanes, even if keys are set
LEADX_PAID_FALLBACK=auto
# How many free, contactable candidates count as "enough" (1.0 = the requested amount)
LEADX_FREE_SUFFICIENCY=1.0
# Free OpenStreetMap discovery stage (set 0 to disable)
LEADX_FREE_OSM=1
# Fields the paid enrichment stage may be spent on (default email,phone). Add owner_name etc. to widen.
LEADX_PAID_ENRICH_FIELDS=email,phone
# Serper owner-name lookups are opt-in (email lookups happen automatically when the free crawl finds none)
ENRICH_SEARCH_FALLBACK_OWNER=0
# Max providers used to re-find a contact after local verification fails
LEADX_MAX_REFILL_PROVIDERS=3
# Free local email verification (SMTP RCPT probe + catch-all control). Needs outbound port 25.
LEADX_SMTP_PROBE=1
LEADX_SMTP_HELO=            # public hostname of this server (reverse DNS should match); default: system FQDN
LEADX_SMTP_PROBE_FROM=      # envelope sender used for the probe; default: postmaster@<HELO>
LEADX_SMTP_PROBE_TIMEOUT=12
LEADX_SMTP_PROBE_CONCURRENCY=8
LEADX_DEFAULT_PHONE_REGION=US

# AI email writing (optional; used by sequence AI-write and personalization)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
