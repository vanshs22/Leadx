STRIPE_API_BASE=                              # TEST ONLY: local Stripe stand-in; ignored in production/staging

# ── Free discovery layer (SearXNG, Overture open data, registries, directories) ──
# Self-hosted SearXNG (json format enabled). Serper is only a paid fallback when SearXNG returns nothing.
SEARXNG_URL=
LEADX_SEARCH_MAX_PAGES=3
LEADX_SEARCH_PAID_FALLBACK=1
LEADX_SEARCH_PAID_MAX_PAGES=1
# Free sources inside the "osm" lane: overture,nppes,companies_house,directories,osm
LEADX_FREE_DISCOVERY=1
LEADX_FREE_SOURCES=overture,nppes,companies_house,directories,osm
OVERTURE_RELEASE=
OVERTURE_MIN_CONFIDENCE=0.5
OVERTURE_MAX_ROWS=5000
LEADX_DUCKDB_HOME=
COMPANIES_HOUSE_API_KEY=
# Directory scraping controls. SCRAPING=0 is the kill switch. No CAPTCHA solving: blocked domains are skipped.
LEADX_DIRECTORY_SCRAPING=1
LEADX_DIRECTORY_ROBOTS=respect
LEADX_DIRECTORY_POLICY={}
LEADX_DIRECTORY_MIN_INTERVAL=1.5
LEADX_DIRECTORY_MAX_PAGES=50
LEADX_DIRECTORY_MAX_LEADS=2000
LEADX_DIRECTORY_DETAIL_FETCH=30
LEADX_DIRECTORY_BREAKER=3
LEADX_DIRECTORY_SEEDS_PER_DOMAIN=6
