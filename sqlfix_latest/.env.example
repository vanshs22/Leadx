# ---- Lead tools ----
LEADX_WEBSITE_FINDER=1            # 0 disables the free domain-probe website finder (paid search stays a fallback)

# ---- Public site, legal pages and SEO (NEXT_PUBLIC_* are baked into the portal at build time) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000     # canonical URL for sitemap.xml / robots.txt
NEXT_PUBLIC_LEGAL_ENTITY=LeadX                # company name shown on legal pages
NEXT_PUBLIC_LEGAL_ADDRESS=                    # postal address (also required in outreach footers)
NEXT_PUBLIC_CONTACT_EMAIL=support@leadx.example
NEXT_PUBLIC_SECURITY_EMAIL=security@leadx.example
