# LeadX real-provider UAT template. Copy to .env.uat outside source control.
# Never copy the workstation .env and never place real values in this file.
ENVIRONMENT=staging
LEADX_UAT_TARGET=uat
LEADX_UAT_ENVIRONMENT=staging
LEADX_UAT_APPLY=0
LEADX_UAT_API_URL=https://uat-api.example.com
LEADX_UAT_PORTAL_URL=https://uat.example.com

# Separate Supabase UAT project. These values are deployment secrets/placeholders.
SUPABASE_URL=https://replace-with-uat-project.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_UAT_ANON_KEY
SUPABASE_SERVICE_KEY=REPLACE_WITH_UAT_SERVICE_KEY
LEAD_ENGINE_SERVICE_KEY=REPLACE_WITH_32_PLUS_CHAR_SERVICE_KEY
DELIVERY_CONFIG_KEY=REPLACE_WITH_32_PLUS_CHAR_DELIVERY_KEY
UNSUBSCRIBE_SECRET=REPLACE_WITH_32_PLUS_CHAR_UNSUBSCRIBE_SECRET
INTEGRATION_OAUTH_STATE_SECRET=REPLACE_WITH_32_PLUS_CHAR_OAUTH_SECRET
CORS_ORIGINS=https://uat.example.com
PUBLIC_API_URL=https://uat-api.example.com
APP_PUBLIC_URL=https://uat.example.com

# Hardened runtime. Local auth and synthetic provider isolation stay off.
LEAD_ENGINE_DEV_AUTH_BYPASS=0
LOCAL_AUTHENTICATION_FLAG=0
LOCAL_VALIDATION_MODE=0
JOB_QUEUE_FAIL_CLOSED=1
REQUIRE_REDIS_FOR_API_READY=1
REQUIRE_WORKER_READY=1
REQUIRE_DISTRIBUTED_RATE_LIMIT=1
PAID_PROVIDER_ISOLATION=0
REDIS_URL=redis://redis:6379/5
LEADX_REDIS_NAMESPACE=leadx-uat
WORKER_ID=leadx-uat-worker
WORKER_QUEUE_FAILURE_POLICY=report_unready

# Explicit UAT quota and outbound safety. The runner rejects larger values.
LEADX_UAT_NEVER_SEND_TO_DISCOVERED=1
LEADX_UAT_DELIVERY_MODE=portal_only
LEADX_UAT_MAX_TARGET=1
LEADX_UAT_MAX_PROVIDER_REQUESTS=5
LEADX_UAT_MAX_ENRICHMENTS=3
LEADX_UAT_MAX_RUNTIME_SECONDS=300
LEADX_UAT_MAX_RETRIES=1
LEADX_PROVIDER_TEST_MODE=uat
LEADX_PAID_FALLBACK=never
LEADX_FREE_OSM=1

# UAT users are provisioned by scripts/uat_bootstrap.py; use test accounts only.
LEADX_UAT_CLIENT_EMAIL=uat-client@example.invalid
LEADX_UAT_CLIENT_PASSWORD=REPLACE_WITH_UAT_CLIENT_PASSWORD
LEADX_UAT_ADMIN_EMAIL=uat-admin@example.invalid
LEADX_UAT_ADMIN_PASSWORD=REPLACE_WITH_UAT_ADMIN_PASSWORD
LEADX_UAT_INVITE_EMAIL=uat-invite@example.invalid
LEADX_UAT_TENANT_A_ID=
LEADX_UAT_TENANT_B_ID=

# Optional real-provider credentials. Keep them in GitHub Environment/VPS secret storage.
SERPER_API_KEY=
FIRECRAWL_API_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_UAT_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_UAT_AWS_SECRET_ACCESS_KEY
LEADX_UAT_SES_SEND=0
LEADX_UAT_SES_FROM_EMAIL=uat-sender@example.com
LEADX_UAT_SES_RECIPIENT_EMAIL=uat-recipient@example.com
LEADX_UAT_SES_INBOUND_WEBHOOK_URL=
LEADX_UAT_SES_INBOUND_SECRET=

# Runtime-only settings used by the API/worker; no real secrets belong here.
TRUST_PROXY_HEADERS=1
WEB_CONCURRENCY=1
WORKER_CONCURRENCY=1
WORKER_HEARTBEAT_SECONDS=15
