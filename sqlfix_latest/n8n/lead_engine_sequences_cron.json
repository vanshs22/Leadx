{
  "name": "Lead Engine - Sequence Follow-ups (Hourly)",
  "active": false,
  "nodes": [
    {
      "id": "cron-seq-001",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [160, 280],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "15 * * * *" }
          ]
        }
      }
    },
    {
      "id": "process-due-001",
      "name": "Process Due Sequence Sends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 280],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/leads/v2/admin/sequences/process-due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SERVICE_KEY }}" }
          ]
        },
        "options": { "timeout": 120000 }
      }
    }
  ],
  "connections": {
    "Hourly": {
      "main": [[{ "node": "Process Due Sequence Sends", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": []
}
